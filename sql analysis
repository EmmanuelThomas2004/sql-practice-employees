CREATE TABLE employees (
    emp_id      INT PRIMARY KEY,
    name        VARCHAR(50) NOT NULL,
    department  VARCHAR(30),
    salary      DECIMAL(10,2),
    hire_date   DATE,
    city        VARCHAR(30)
);

