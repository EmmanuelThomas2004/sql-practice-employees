1. All employees in the IT department


SELECT * FROM employees WHERE department = 'IT';

2. Employees earning more than 55,000, highest first

SELECT name, salary
FROM employees
WHERE salary > 55000
ORDER BY salary DESC;

3. Employee count and average salary per department

SELECT department,
       COUNT(*)    AS total_employees,
       AVG(salary) AS avg_salary
FROM employees
GROUP BY department;

4. Employees hired on or after 1 January 2020


SELECT name, hire_date
FROM employees
WHERE hire_date >= '2020-01-01';

5. Employee with the highest salary (subquery)


SELECT name, salary
FROM employees
WHERE salary = (SELECT MAX(salary) FROM employees);
